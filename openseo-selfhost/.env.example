# Required — see docs/DATAFORSEO_API_KEY.md in every-app/open-seo.
# base64("your-dataforseo-email:your-dataforseo-api-password")
DATAFORSEO_API_KEY=

# Your real domain/IP once this sits behind a reverse proxy (e.g. seo.yourdomain.com)
ALLOWED_HOST=

PORT=3001

# AUTH_MODE is forced to local_noauth in compose.yaml — this instance has NO
# login. Only expose it behind your own auth (reverse proxy with basic auth,
# a VPN, or an SSH tunnel) — never bind it to 0.0.0.0 on a public IP directly.
